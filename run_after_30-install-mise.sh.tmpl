#!/bin/sh

set -eu

log() {
    printf '==> %s\n' "$*"
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

if command -v mise >/dev/null 2>&1; then
    log "mise is already installed"
    exit 0
fi

[ -n "${HOME:-}" ] ||
    die "HOME is not set; cannot determine the mise installation path"

mise_path="$HOME/.local/bin/mise"

if [ -x "$mise_path" ]; then
    log "mise is already installed at $mise_path"
    exit 0
fi

command -v curl >/dev/null 2>&1 ||
    die "curl is required; install it and rerun chezmoi apply"

log "Installing mise to $mise_path"

if ! curl -fsSL https://mise.run |
    MISE_INSTALL_PATH="$mise_path" MISE_INSTALL_HELP=0 sh
then
    die "mise installer failed"
fi

if [ ! -x "$mise_path" ] ||
    ! "$mise_path" --version >/dev/null 2>&1
then
    die "mise installation validation failed for $mise_path"
fi

log "mise installed successfully at $mise_path"
